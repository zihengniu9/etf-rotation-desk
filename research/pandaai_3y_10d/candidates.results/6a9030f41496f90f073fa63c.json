    "code": "class TrendBreakout(Factor):\n    def calculate(self, factors):\n        close = factors[\"close\"]\n        high = factors[\"high\"]\n        prior_high60 = DELAY(TS_MAX(high, 60), 1)\n        breakout_distance = close / prior_high60 - 1.0\n        return MAX(0.0, MIN(1.0, (breakout_distance + 0.10) / 0.11))\n\n"
   },
