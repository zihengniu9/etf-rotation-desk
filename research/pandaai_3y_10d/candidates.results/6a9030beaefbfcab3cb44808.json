    "code": "class TrendStructure(Factor):\n    def calculate(self, factors):\n        close = factors[\"close\"]\n        ma20 = MA(close, 20)\n        ma60 = MA(close, 60)\n        ma120 = MA(close, 120)\n        above20 = close > ma20\n        mid_alignment = above20 & (ma20 > ma60)\n        full_alignment = mid_alignment & (ma60 > ma120)\n        return IF(full_alignment, 1.0, IF(mid_alignment, 0.70, IF(above20, 0.35, 0.0)))\n\n"
   },
